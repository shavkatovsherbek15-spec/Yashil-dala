DATABASE_URL=postgresql+psycopg://yashil:yashil@localhost:5432/yashil_dala
# Ishlab chiqarishda albatta uzun tasodifiy qiymat qo'ying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
DEFAULT_LANG=uz
# HTTPS'da ishlaganda true qiling (sessiya cookie faqat HTTPS orqali)
SESSION_HTTPS_ONLY=false
# Admin yuklagan rasmlar papkasi va hajm chegarasi (MB)
MEDIA_DIR=media
MAX_UPLOAD_MB=5

SHOP_NAME=Yashil Dala
SHOP_PHONE=+998 [raqam]
SHOP_ADDRESS=[manzil]
SHOP_LICENSE=[raqam]
SHOP_TELEGRAM=https://t.me/
# Yetkazib berish narxi, so'm (0 = hali belgilanmagan)
DELIVERY_PRICE=0

# Telegram bot (@BotFather). Bo'sh bo'lsa xabar yuborilmaydi, faqat logga yoziladi.
TELEGRAM_BOT_TOKEN=
# Do'kon egasining chat ID raqami (yoki guruh ID, -100... bilan)
TELEGRAM_CHAT_ID=
# Webhook uchun maxfiy so'z (setWebhook secret_token bilan bir xil)
TELEGRAM_WEBHOOK_SECRET=
